---
import { Check, ArrowUpRight, ArrowLeft, ArrowRight, X } from '@lucide/astro';
import { team, specialties, imagingDetail } from '@data/team';
import TiltedCard from './react/TiltedCard.jsx';

const featured = team.filter((m) => m.featured);
const crew = team.filter((m) => !m.featured);

const socialIcons = {
  instagram: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>`,
  linkedin: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M7 10v7M7 7v.01M11 17v-4.5a2.5 2.5 0 015 0V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};
---

<section id="team" class="section-spacing team-section" aria-labelledby="team-heading">
  <div class="container-gutter">

    <!-- Header -->
    <div class="team__header">
      <span class="team__label reveal-up">El equipo</span>
      <h2 id="team-heading" class="team__heading reveal-up">
        Profesionales que<br/>
        <em>aman</em> lo que hacen.
      </h2>
    </div>

    <!-- Featured member(s) -->
    {featured.map((member) => (
      <article class="member">
        <div class="member__photo-col reveal-left">
          <div class="member__frame">
            <TiltedCard
              client:visible
              imageSrc={member.img}
              imageAlt={member.imgAlt}
              badgeText={member.role}
            />
          </div>
        </div>

        <div class="member__copy-col">
          <h3 class="member__name reveal-up">{member.name}</h3>
          <p class="member__title reveal-up">{member.role} &middot; {member.specialty}</p>
          <p class="member__bio reveal-up">{member.longBio}</p>

          {member.credentials.length > 0 && (
            <ul class="member__credentials" data-stagger-parent aria-label={`Credenciales de ${member.name}`}>
              {member.credentials.map((c) => (
                <li class="member__credential" data-stagger-child>
                  <Check stroke-width="2.5" class="w-4 h-4 member__credential-icon" aria-hidden="true" />
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="member__footer reveal-up">
            <a href="#contact" class="btn-primary member__cta">Agendar cita</a>
            {(member.social.instagram || member.social.linkedin) && (
              <div class="member__social" aria-label="Redes sociales">
                {member.social.instagram && (
                  <a
                    href={member.social.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Instagram de ${member.name}`}
                    class="member__social-link"
                    set:html={socialIcons.instagram}
                  />
                )}
                {member.social.linkedin && (
                  <a
                    href={member.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`LinkedIn de ${member.name}`}
                    class="member__social-link"
                    set:html={socialIcons.linkedin}
                  />
                )}
              </div>
            )}
          </div>
        </div>
      </article>
    ))}

    <!-- Resto del equipo -->
    {crew.length > 0 && (
      <div class="crew">
        <div class="crew__header reveal-up">
          <p class="team__eyebrow">Junto a la Dra. Carolina</p>
          <h3 class="crew__heading">Un equipo que cuida a tu mascota <em>como familia</em>.</h3>
        </div>

        <ul class="crew__grid" data-stagger-parent aria-label="Equipo de Anisanar">
          {crew.map((m) => (
            <li class="crew-card" data-stagger-child>
              <div class="crew-card__photo">
                <TiltedCard
                  client:visible
                  imageSrc={m.img}
                  imageAlt={m.imgAlt}
                  badgeText={m.role}
                  rotateAmplitude={10}
                />
              </div>
              <h4 class="crew-card__name">{m.name}</h4>
              <p class="crew-card__role">{m.specialty}</p>
              <p class="crew-card__bio">{m.bio}</p>

              <button
                type="button"
                class="crew-card__more"
                data-profile-open={`perfil-${m.id}`}
                aria-haspopup="dialog"
              >
                Conocer más
                <ArrowUpRight stroke-width="2" class="crew-card__more-icon" aria-hidden="true" />
              </button>
            </li>
          ))}
        </ul>

        {crew.map((m, i) => {
          const prev = crew[(i - 1 + crew.length) % crew.length];
          const next = crew[(i + 1) % crew.length];
          return (
            <dialog class="profile" id={`perfil-${m.id}`} aria-labelledby={`perfil-${m.id}-name`}>
              <div class="profile__panel">
                <div class="profile__photo">
                  <img src={m.img} alt={m.imgAlt} loading="lazy" decoding="async" />
                  <span class="profile__count">{String(i + 1).padStart(2, '0')} / {String(crew.length).padStart(2, '0')}</span>
                </div>

                <div class="profile__body" data-lenis-prevent>
                  <button type="button" class="profile__close" data-profile-close aria-label="Cerrar perfil">
                    <X stroke-width="2" aria-hidden="true" />
                  </button>

                  <p class="profile__role">{m.role}</p>
                  <h3 id={`perfil-${m.id}-name`} class="profile__name" tabindex="-1" autofocus>{m.name}</h3>
                  <p class="profile__specialty">{m.specialty}</p>

                  <p class="profile__bio">{m.longBio}</p>

                  {m.credentials.length > 0 && (
                    <ul class="profile__credentials" aria-label={`Formación y experiencia de ${m.name}`}>
                      {m.credentials.map((c) => (
                        <li>
                          <Check stroke-width="2.5" class="profile__check" aria-hidden="true" />
                          <span>{c}</span>
                        </li>
                      ))}
                    </ul>
                  )}

                  <div class="profile__footer">
                    <a href="#contact" class="btn-primary profile__cta" data-profile-close>Agendar cita</a>
                    <nav class="profile__nav" aria-label="Otros integrantes del equipo">
                      <button type="button" class="profile__nav-btn" data-dir="-1" data-profile-open={`perfil-${prev.id}`} aria-label={`Anterior: ${prev.name}`}>
                        <ArrowLeft stroke-width="2" aria-hidden="true" />
                      </button>
                      <button type="button" class="profile__nav-btn" data-dir="1" data-profile-open={`perfil-${next.id}`} aria-label={`Siguiente: ${next.name}`}>
                        <ArrowRight stroke-width="2" aria-hidden="true" />
                      </button>
                    </nav>
                  </div>
                </div>
              </div>
            </dialog>
          );
        })}
      </div>
    )}

    <!-- Especialidades -->
    <div class="team__specialties reveal-up">
      <p class="team__eyebrow">Especialistas al cuidado de tu mascota</p>
      <ul class="team__specialty-list" data-stagger-parent aria-label="Especialidades de Anisanar">
        {specialties.map((s) => (
          <li
            class="team__specialty-chip"
            data-stagger-child
            title={s === 'Imagenología' ? imagingDetail : undefined}
          >
            {s}
            {s === 'Imagenología' && <span class="team__specialty-detail">{imagingDetail}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Fondo oscuro, continúa sin salto desde Servicios hacia Galería */
  .team-section {
    background: var(--color-charcoal);
    overflow-x: hidden;
    padding-top: 0;
  }

  /* ── Header ─────────────────────────────────────────────────────────────── */
  .team__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .team__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-clay);
  }

  .team__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 500;
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .team__heading em {
    color: var(--color-clay);
    font-style: normal;
  }

  /* ── Member spotlight ──────────────────────────────────────────────────── */
  .member {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .member + .member {
    margin-top: clamp(4rem, 6vw, 6rem);
    padding-top: clamp(4rem, 6vw, 6rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Photo col */
  .member__photo-col { position: relative; }

  .member__frame {
    max-width: 420px;
    aspect-ratio: 4 / 5;
  }

  /* Copy col */
  .member__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.375rem;
  }

  .member__title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-clay);
    margin-bottom: 1.5rem;
  }

  .member__bio {
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .member__credentials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .member__credential {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }

  .member__credential-icon {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-clay);
  }

  .member__footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .member__social {
    display: flex;
    gap: 0.625rem;
  }

  .member__social-link {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .member__social-link:hover {
    border-color: var(--color-clay);
    color: var(--color-clay);
  }

  /* ── Etiqueta pequeña compartida (equipo y especialidades) ─────────────── */
  .team__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 1.25rem;
  }

  /* ── Resto del equipo ──────────────────────────────────────────────────── */
  .crew {
    margin-top: clamp(4rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .crew__header { margin-bottom: clamp(2rem, 4vw, 3rem); }

  .crew__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.2;
    color: #ffffff;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  .crew__heading em {
    color: var(--color-clay);
    font-style: normal;
  }

  .crew__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 2.5vw, 2rem);
    align-items: stretch;
  }

  /* columna: "Conocer más" queda siempre abajo, alineado entre compañeros de la misma fila */
  .crew-card { display: flex; flex-direction: column; }

  .crew-card__photo {
    aspect-ratio: 4 / 5;
    margin-bottom: 1.25rem;
  }

  /* Etiqueta de rol algo más compacta que en la tarjeta destacada */
  .crew-card__photo :global(.tilted-card__badge) {
    bottom: 0.875rem;
    left: 0.875rem;
    right: 0.875rem;
    width: fit-content;
    max-width: calc(100% - 1.75rem);
    padding: 0.5rem 0.85rem;
  }

  .crew-card__photo :global(.tilted-card__badge span) {
    font-size: 0.75rem;
    white-space: normal;
  }

  .crew-card__name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.3;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .crew-card__role {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-clay);
    margin-bottom: 0.75rem;
  }

  .crew-card__bio {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 0.875rem;
  }

  /* "Conocer más": enlace discreto que abre el perfil (no despliega nada dentro de la tarjeta) */
  .crew-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: auto;
    align-self: flex-start;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 0.15rem;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .crew-card__more:hover,
  .crew-card__more:focus-visible {
    color: var(--color-clay);
    border-color: var(--color-clay);
  }

  .crew-card__more:focus-visible { outline: 2px solid var(--color-clay); outline-offset: 4px; border-radius: 2px; }

  .crew-card__more-icon {
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--ease-expo);
  }

  .crew-card__more:hover .crew-card__more-icon { transform: translate(2px, -2px); }

  /* ── Perfil (diálogo) ──────────────────────────────────────────────────── */
  .profile {
    width: min(880px, calc(100vw - 2rem));
    max-width: none;
    max-height: min(620px, calc(100dvh - 3rem));
    margin: auto;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    background: #16202f;
    color: #ffffff;
    overflow: hidden;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.55);
  }

  .profile::backdrop {
    background: rgba(8, 13, 22, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* la apertura y el cierre los anima el script (GSAP): fondo, panel, cortina de la foto y texto en cascada */

  .profile__panel {
    display: grid;
    grid-template-columns: 0.82fr 1fr;
    height: min(620px, calc(100dvh - 3rem));
  }

  .profile__photo {
    position: relative;
    overflow: hidden;   /* el zoom de la foto al abrir no se sale de su columna */
    background: #0f1724;
  }

  .profile__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }

  /* degradado que funde la foto con el panel */
  .profile__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 65%, #16202f 100%);
    pointer-events: none;
  }

  .profile__count {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 1;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #ffffff;
    background: rgba(8, 13, 22, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.35rem 0.7rem;
    border-radius: 9999px;
  }

  .profile__body {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.75rem, 3.5vw, 2.75rem) clamp(1.5rem, 3vw, 2rem);
    min-height: 0;   /* deja que la columna se encoja y tenga su propio scroll */
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .profile__name:focus { outline: none; }

  .profile__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.3s var(--ease-expo);
  }

  .profile__close :global(svg) { width: 18px; height: 18px; }

  .profile__close:hover,
  .profile__close:focus-visible {
    border-color: var(--color-clay);
    color: var(--color-clay);
    transform: rotate(90deg);
  }

  .profile__role {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-clay);
    margin-bottom: 0.75rem;
    padding-right: 3rem;
  }

  .profile__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    padding-right: 2.5rem;
  }

  .profile__specialty {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .profile__bio {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.72);
  }

  .profile__credentials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .profile__credentials li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
  }

  .profile__check {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 0.1em;
    color: var(--color-clay);
  }

  .profile__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.75rem;
  }

  .profile__cta { padding: 0.75rem 1.6rem; font-size: 0.875rem; }

  .profile__nav { display: flex; gap: 0.5rem; }

  .profile__nav-btn {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
  }

  .profile__nav-btn :global(svg) { width: 18px; height: 18px; }

  .profile__nav-btn:hover,
  .profile__nav-btn:focus-visible {
    border-color: var(--color-clay);
    color: var(--color-clay);
    background: rgba(140, 198, 63, 0.08);
  }

  /* móvil: hoja que sube desde abajo, foto arriba como banda */
  @media (max-width: 720px) {
    .profile {
      width: 100vw;
      max-height: 92dvh;
      margin: auto 0 0;
      border-radius: 1.5rem 1.5rem 0 0;
      border-bottom: 0;
    }
    .profile__panel { grid-template-columns: 1fr; grid-template-rows: auto 1fr; height: auto; max-height: 92dvh; }
    .profile__photo { height: 240px; }
    .profile__photo::after { background: linear-gradient(180deg, transparent 55%, #16202f 100%); }
    .profile__body { padding: 1.5rem 1.25rem 1.5rem; }
    .profile__panel { position: relative; }
    .profile__body { position: static; }  /* la X se ancla al panel: queda sobre la foto y no se desplaza con el texto */
    .profile__close { top: 0.75rem; right: 0.75rem; z-index: 2; background: rgba(8, 13, 22, 0.55); backdrop-filter: blur(8px); }
  }

  /* ── Especialidades ────────────────────────────────────────────────────── */
  .team__specialties {
    margin-top: clamp(4rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .team__specialty-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .team__specialty-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .team__specialty-chip:hover {
    border-color: var(--color-clay);
    color: #ffffff;
  }

  .team__specialty-detail {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-clay);
  }

  @media (prefers-reduced-motion: reduce) {
    .crew-card__more-icon { transition: none; }
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .member { grid-template-columns: 1fr; }
    .member__frame { max-width: 320px; margin: 0 auto; }
  }

  @media (max-width: 560px) {
    .crew__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
    .crew-card__name { font-size: 1rem; }
    .crew-card__bio { display: none; }  /* en móvil la historia completa está en "Conocer más" */
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Perfiles del equipo: un <dialog> por integrante (foco atrapado y teclado nativos). La apertura es una coreografía:
  // el fondo se oscurece, el panel sube y se asienta, la foto se descubre con una cortina y el texto entra en cascada.
  // Corre aunque el sistema pida reducir movimiento (Windows con animaciones apagadas lo reporta así y el modal
  // solo "aparecía"): son movimientos cortos que se asientan, sin bucles. Se cierra con la X, haciendo clic fuera o con Esc; las flechas pasan al anterior o siguiente deslizando el contenido.
  const lenis = (window as any).__lenis;
  const mobile = () => window.matchMedia('(max-width: 720px)').matches;
  const EASE = 'expo.out';
  let current: HTMLDialogElement | null = null;
  let closing = false;

  const parts = (dlg: HTMLDialogElement) => ({
    photo: dlg.querySelector<HTMLElement>('.profile__photo'),
    img: dlg.querySelector<HTMLElement>('.profile__photo img'),
    count: dlg.querySelector<HTMLElement>('.profile__count'),
    close: dlg.querySelector<HTMLElement>('.profile__close'),
    items: dlg.querySelectorAll<HTMLElement>(
      '.profile__role, .profile__name, .profile__specialty, .profile__bio, .profile__credentials li, .profile__footer'),
  });

  // el ::backdrop no lo anima GSAP: se usa la Web Animations API sobre el pseudo-elemento
  const fades = new WeakMap<HTMLDialogElement, Animation>();
  const backdrop = (dlg: HTMLDialogElement, from: number, to: number, duration: number) => {
    fades.get(dlg)?.cancel();
    try { fades.set(dlg, dlg.animate({ opacity: [from, to] }, { duration, easing: 'ease', fill: 'forwards', pseudoElement: '::backdrop' })); }
    catch { /* navegador sin animación de ::backdrop: aparece sin fundido */ }
  };

  function reveal(dlg: HTMLDialogElement, dir = 0) {
    const p = parts(dlg);
    gsap.killTweensOf([dlg, p.photo, p.img, p.count, p.close, ...p.items]);
    const tl = gsap.timeline({ defaults: { ease: EASE } });
    // cada estado inicial se fija ya (antes del primer cuadro), así el panel nunca se ve completo un instante
    const ft = (t: gsap.TweenTarget, from: gsap.TweenVars, to: gsap.TweenVars, at: number) => { gsap.set(t, { ...from, lazy: false }); tl.fromTo(t, from, to, at); };
    if (dir === 0) {
      backdrop(dlg, 0, 1, 450);
      ft(dlg, mobile()
        ? { yPercent: 100, opacity: 1 }
        : { opacity: 0, y: 46, scale: 0.92, rotationX: 7, transformPerspective: 1400, transformOrigin: '50% 100%' },
        { yPercent: 0, opacity: 1, y: 0, scale: 1, rotationX: 0, duration: mobile() ? 0.65 : 0.8 }, 0);
    }
    // cortina sobre la foto (de izquierda a derecha; en móvil, de arriba abajo) y un leve zoom que se asienta
    const shut = dir < 0 ? 'inset(0% 0% 0% 100%)' : mobile() ? 'inset(0% 0% 100% 0%)' : 'inset(0% 100% 0% 0%)';
    ft(p.photo, { clipPath: shut }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.9, ease: 'power4.inOut' }, dir ? 0 : 0.08);
    ft(p.img, { scale: 1.22 }, { scale: 1, duration: 1.3 }, dir ? 0 : 0.08);
    ft(p.count, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5 }, dir ? 0.35 : 0.55);
    ft(p.items, { opacity: 0, x: dir * 36, y: dir ? 0 : 22, filter: 'blur(6px)' },
      { opacity: 1, x: 0, y: 0, filter: 'blur(0px)', duration: 0.7, stagger: 0.06, clearProps: 'filter' }, dir ? 0.05 : 0.22);
    if (dir === 0) ft(p.close, { opacity: 0, scale: 0.5, rotation: -90 },
      { opacity: 1, scale: 1, rotation: 0, duration: 0.6, ease: 'back.out(2)', clearProps: 'transform' }, 0.4);
  }

  const open = (id: string, dir = 0) => {
    const next = document.getElementById(id) as HTMLDialogElement | null;
    if (!next || next === current) return;
    const switching = !!current && dir !== 0;
    if (current) { gsap.killTweensOf(current); current.close(); gsap.set(current, { clearProps: 'all' }); }
    next.showModal();   // los estados iniciales se fijan en la misma tarea: no hay cuadro intermedio visible
    next.querySelector<HTMLElement>('.profile__body')?.scrollTo({ top: 0 });
    current = next;
    lenis?.stop();
    if (switching) backdrop(next, 1, 1, 1);   // el fondo ya estaba oscuro: sin parpadeo al cambiar de integrante
    reveal(next, switching ? dir : 0);
  };

  const finish = (dlg: HTMLDialogElement) => {
    dlg.close();
    gsap.set(dlg, { clearProps: 'all' });
    if (current === dlg) current = null;
    closing = false;
    lenis?.start();   // se reanuda ya (el evento close llega después) para que "Agendar cita" baje suave
  };

  const close = (dlg: HTMLDialogElement, animate = true) => {
    if (closing) return;
    if (!animate) { finish(dlg); return; }
    closing = true;
    const p = parts(dlg);
    gsap.killTweensOf([dlg, ...p.items]);
    backdrop(dlg, 1, 0, 300);
    gsap.timeline({ onComplete: () => finish(dlg) })
      .to(p.items, { opacity: 0, y: -8, duration: 0.18, stagger: 0.02, ease: 'power2.in' }, 0)
      .to(dlg, mobile()
        ? { yPercent: 100, duration: 0.4, ease: 'power3.in' }
        : { opacity: 0, y: 28, scale: 0.95, duration: 0.32, ease: 'power3.in' }, 0.06);
  };

  document.querySelectorAll<HTMLElement>('[data-profile-open]').forEach((btn) =>
    btn.addEventListener('click', () => open(btn.dataset.profileOpen!, Number(btn.dataset.dir ?? 0))));

  document.querySelectorAll<HTMLDialogElement>('dialog.profile').forEach((dlg) => {
    dlg.addEventListener('close', () => { if (current === dlg) { current = null; lenis?.start(); } });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(dlg); });       // Esc: también con animación
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(dlg); });       // clic en el fondo
    dlg.querySelectorAll<HTMLElement>('[data-profile-close]').forEach((el) =>
      // "Agendar cita" cierra al instante para que el enlace lleve suave al formulario
      el.addEventListener('click', () => close(dlg, el.tagName !== 'A')));
  });
</script>
