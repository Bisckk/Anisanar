---
import SEO from '@components/SEO.astro';
import '@styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: object;
  noindex?: boolean;
}

const { title, description, canonical, image, imageAlt, type, schema, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preload hero background image (LCP) -->
    <link rel="preload" as="image" href="/anisanar/hero-equipo-veterinario.jpg" fetchpriority="high" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      schema={schema}
      noindex={noindex}
    />
  </head>
  <body>
    <!-- Scroll to top on every page load/reload -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>

    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      gsap.registerPlugin(ScrollTrigger);

      // ─── Smooth Scroll (Lenis) ──────────────────────────────────────────────
      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true,
        syncTouch: true,
        // táctil: el dedo mueve la página 1:1 y, al soltar, el impulso es corto y frena despacio para recorrer la
        // página con calma. El impulso crece como velocidad^exponente: con 1.85 un gesto rápido real (≈40 px por
        // cuadro) recorría ~900 px; con 1.6 recorre ~360 px. Un lerp más bajo alarga y suaviza esa frenada.
        touchMultiplier: 1,
        touchInertiaExponent: 1.6,
        syncTouchLerp: 0.045,
      });

      // Sincronizar Lenis con GSAP
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
      (window as any).__lenis = lenis;   // la usan otros componentes (navegación, perfiles del equipo)

      // ─── Enlaces a secciones (#id) con el mismo scroll suave de Lenis ──────
      // El salto nativo (scroll-behavior) choca con Lenis y se ve brusco; aquí cada enlace interno se anima con Lenis
      // y el historial guarda la sección, así "Atrás" vuelve con el mismo suavizado.
      const scrollToHash = (hash: string, immediate = false) => {
        const target = hash && hash !== '#' ? document.querySelector<HTMLElement>(hash) : null;
        if (hash && hash !== '#' && !target) return false;
        lenis.scrollTo(target ?? 0, {
          duration: immediate ? 0 : 1.5,
          easing: (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)),   // expo.out, como el resto del sitio
          immediate,
        });
        return true;
      };
      (window as any).__scrollToHash = scrollToHash;

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!link || link.target === '_blank') return;
        const url = new URL(link.href, location.href);
        if (url.pathname !== location.pathname || url.origin !== location.origin) return;
        if (!scrollToHash(url.hash)) return;
        e.preventDefault();
        if (url.hash !== location.hash) history.pushState(null, '', url.hash || location.pathname);
      });
      window.addEventListener('popstate', () => scrollToHash(location.hash));

      // Custom cursor animations have been removed.

      // ─── Scroll Reveals ─────────────────────────────────────────────────────
      const revealClasses = [
        { selector: '.reveal-up',    y: 28,  x: 0 },
        { selector: '.reveal-left',  y: 0,   x: -28 },
        { selector: '.reveal-right', y: 0,   x: 28 },
      ];

      revealClasses.forEach(({ selector, y, x }) => {
        gsap.utils.toArray<HTMLElement>(selector).forEach((el) => {
          gsap.set(el, { opacity: 0, y, x });
          ScrollTrigger.create({
            trigger: el,
            start: 'top 90%',
            onEnter: () => {
              gsap.to(el, {
                opacity: 1,
                y: 0,
                x: 0,
                duration: 0.65,
                ease: 'expo.out',
              });
            },
          });
        });
      });

      gsap.utils.toArray<HTMLElement>('.reveal-scale').forEach((el) => {
        gsap.set(el, { opacity: 0, scale: 0.94 });
        ScrollTrigger.create({
          trigger: el,
          start: 'top 90%',
          onEnter: () => {
            gsap.to(el, {
              opacity: 1,
              scale: 1,
              duration: 0.65,
              ease: 'power3.out',
            });
          },
        });
      });

      // ─── Stagger Groups ──────────────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-stagger-parent]').forEach((parent) => {
        const children = parent.querySelectorAll<HTMLElement>('[data-stagger-child]');
        gsap.set(children, { opacity: 0, y: 20 });
        ScrollTrigger.create({
          trigger: parent,
          start: 'top 84%',
          onEnter: () => {
            gsap.to(children, {
              opacity: 1,
              y: 0,
              duration: 0.55,
              ease: 'expo.out',
              stagger: 0.07,
            });
          },
        });
      });

      // ─── Parallax ───────────────────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
        const speed = parseFloat(el.dataset.parallax ?? '0.3');
        gsap.to(el, {
          yPercent: speed * 100,
          ease: 'none',
          scrollTrigger: {
            trigger: el.parentElement ?? el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });
      });

      // ─── Refresh triggers when layout shifts ──────────────────────────────────
      // Islands hydrate (client:visible/client:load) and images load after the
      // triggers above were calculated, which can shift the page height and
      // leave `.reveal-*` elements stuck at opacity:0 forever. Recalculate
      // whenever the document's height actually changes.
      let refreshTimer: ReturnType<typeof setTimeout>;
      new ResizeObserver(() => {
        clearTimeout(refreshTimer);
        refreshTimer = setTimeout(() => ScrollTrigger.refresh(), 150);
      }).observe(document.body);

      window.addEventListener('load', () => ScrollTrigger.refresh());

      // ─── Failsafe ───────────────────────────────────────────────────────────
      // If for any reason (script error elsewhere, blocked module, disabled JS
      // animation, GSAP ticker stalled, etc.) an element never got revealed,
      // snap it visible after a few seconds so content is never permanently
      // hidden. Uses gsap.set (instant, no ticker dependency) rather than
      // gsap.to so it can't itself be broken by whatever stalled the ticker.
      setTimeout(() => {
        document.querySelectorAll<HTMLElement>('.reveal-up, .reveal-left, .reveal-right, .reveal-scale')
          .forEach((el) => {
            if (getComputedStyle(el).opacity === '0') {
              gsap.set(el, { opacity: 1, x: 0, y: 0, scale: 1 });
            }
          });
      }, 3000);
    </script>
  </body>
</html>
