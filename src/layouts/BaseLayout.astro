---
import SEO from '@components/SEO.astro';
import '@styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: object;
  noindex?: boolean;
}

const { title, description, canonical, image, imageAlt, type, schema, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preconnect to external image CDN -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <!-- Preload hero background image (LCP) -->
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=1400&q=80&fm=webp&auto=format" fetchpriority="high" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      schema={schema}
      noindex={noindex}
    />
  </head>
  <body>
    <!-- Scroll to top on every page load/reload -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>

    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      gsap.registerPlugin(ScrollTrigger);

      // ─── Smooth Scroll (Lenis) ──────────────────────────────────────────────
      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true,
        syncTouch: true,
        touchMultiplier: 2,
      });

      // Sincronizar Lenis con GSAP
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // Custom cursor animations have been removed.

      // ─── Scroll Reveals ─────────────────────────────────────────────────────
      const revealClasses = [
        { selector: '.reveal-up',    y: 28,  x: 0 },
        { selector: '.reveal-left',  y: 0,   x: -28 },
        { selector: '.reveal-right', y: 0,   x: 28 },
      ];

      revealClasses.forEach(({ selector, y, x }) => {
        gsap.utils.toArray<HTMLElement>(selector).forEach((el) => {
          gsap.set(el, { opacity: 0, y, x });
          ScrollTrigger.create({
            trigger: el,
            start: 'top 90%',
            onEnter: () => {
              gsap.to(el, {
                opacity: 1,
                y: 0,
                x: 0,
                duration: 0.65,
                ease: 'expo.out',
              });
            },
          });
        });
      });

      gsap.utils.toArray<HTMLElement>('.reveal-scale').forEach((el) => {
        gsap.set(el, { opacity: 0, scale: 0.94 });
        ScrollTrigger.create({
          trigger: el,
          start: 'top 90%',
          onEnter: () => {
            gsap.to(el, {
              opacity: 1,
              scale: 1,
              duration: 0.65,
              ease: 'power3.out',
            });
          },
        });
      });

      // ─── Stagger Groups ──────────────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-stagger-parent]').forEach((parent) => {
        const children = parent.querySelectorAll<HTMLElement>('[data-stagger-child]');
        gsap.set(children, { opacity: 0, y: 20 });
        ScrollTrigger.create({
          trigger: parent,
          start: 'top 84%',
          onEnter: () => {
            gsap.to(children, {
              opacity: 1,
              y: 0,
              duration: 0.55,
              ease: 'expo.out',
              stagger: 0.07,
            });
          },
        });
      });

      // ─── Parallax ───────────────────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
        const speed = parseFloat(el.dataset.parallax ?? '0.3');
        gsap.to(el, {
          yPercent: speed * 100,
          ease: 'none',
          scrollTrigger: {
            trigger: el.parentElement ?? el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });
      });

      // ─── Refresh triggers when layout shifts ──────────────────────────────────
      // Islands hydrate (client:visible/client:load) and images load after the
      // triggers above were calculated, which can shift the page height and
      // leave `.reveal-*` elements stuck at opacity:0 forever. Recalculate
      // whenever the document's height actually changes.
      let refreshTimer: ReturnType<typeof setTimeout>;
      new ResizeObserver(() => {
        clearTimeout(refreshTimer);
        refreshTimer = setTimeout(() => ScrollTrigger.refresh(), 150);
      }).observe(document.body);

      window.addEventListener('load', () => ScrollTrigger.refresh());

      // ─── Failsafe ───────────────────────────────────────────────────────────
      // If for any reason (script error elsewhere, blocked module, disabled JS
      // animation, GSAP ticker stalled, etc.) an element never got revealed,
      // snap it visible after a few seconds so content is never permanently
      // hidden. Uses gsap.set (instant, no ticker dependency) rather than
      // gsap.to so it can't itself be broken by whatever stalled the ticker.
      setTimeout(() => {
        document.querySelectorAll<HTMLElement>('.reveal-up, .reveal-left, .reveal-right, .reveal-scale')
          .forEach((el) => {
            if (getComputedStyle(el).opacity === '0') {
              gsap.set(el, { opacity: 1, x: 0, y: 0, scale: 1 });
            }
          });
      }, 3000);
    </script>
  </body>
</html>
